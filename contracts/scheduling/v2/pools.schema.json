{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actingcommand.local/contracts/scheduling/v2/pools.schema.json",
  "title": "ActingCommand Scheduling Pools v2",
  "type": "object",
  "required": ["schema_version", "catalog", "pools"],
  "properties": {
    "schema_version": { "const": "actingcommand.scheduling.v2" },
    "catalog": { "$ref": "./common.schema.json#/$defs/catalog" },
    "pools": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/pool" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "fact_key"],
          "properties": {
            "kind": { "const": "fact" },
            "fact_key": { "$ref": "./common.schema.json#/$defs/identifier" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "task_id", "outcome_key"],
          "properties": {
            "kind": { "const": "outcome" },
            "task_id": { "$ref": "./common.schema.json#/$defs/itemId" },
            "outcome_key": { "$ref": "./common.schema.json#/$defs/identifier" }
          },
          "additionalProperties": false
        },
        {
          "description": "#455 P1 (since 0.12.78): the pool's inventory is the sum over rows of the integer value_column holds in the row of the list reading fact_key whose key_column holds the row's key, times its factor. Only beside a ledger_fact value_source, in a pool of an instance's scope; key_column and value_column differ, and the rows' keys are distinct. No host computes the sum before a later slice: until then the pool has no reading. A schedule.json whose pool writes it names pool_list_rows in requires.",
          "type": "object",
          "required": ["kind", "fact_key", "key_column", "value_column", "rows"],
          "properties": {
            "kind": { "const": "list_rows" },
            "fact_key": { "type": "string", "pattern": "^inventory\\.list\\.", "maxLength": 128 },
            "key_column": { "$ref": "#/$defs/listColumn" },
            "value_column": { "$ref": "#/$defs/listColumn" },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["key", "factor"],
                "properties": {
                  "key": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
                  "factor": { "type": "integer", "minimum": 1, "maximum": 1000000 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "listColumn": {
      "description": "#455 P1: a list column's name, as a list reading declares its key_column and columns.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "pool": {
      "type": "object",
      "required": ["id", "scope", "capacity", "projection", "observation", "group_delay"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/itemId" },
        "scope": { "$ref": "./common.schema.json#/$defs/scope" },
        "capacity": {
          "description": "A positive integer, or (#386 CF-5) a fact reference read in the pool's scope at each evaluation, as the pool reads its own value: the capacity is that fact's integer plus offset and must be at least 1, otherwise the pool has no value and its resource_projection is Unknown with the fact's reason. A reading above it stays as read; regeneration stops at it. A schedule.json that writes one names pool_fact_reference in requires.",
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            { "$ref": "./common.schema.json#/$defs/factReference" }
          ]
        },
        "projection": {
          "oneOf": [
            {
              "type": "object",
              "required": ["amount", "per_ms"],
              "properties": {
                "amount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "per_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "none" } },
              "additionalProperties": false
            }
          ]
        },
        "observation": { "$ref": "#/$defs/observation" },
        "value_source": {
          "oneOf": [
            { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "static_snapshot" } }, "additionalProperties": false },
            { "type": "object", "required": ["kind", "minimum_confidence_milli"], "properties": { "kind": { "const": "ledger_fact" }, "minimum_confidence_milli": { "type": "integer", "minimum": 1, "maximum": 1000 } }, "additionalProperties": false }
          ]
        },
        "group_delay": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["minimum_delay_ms", "maximum_delay_ms"],
              "properties": {
                "minimum_delay_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "maximum_delay_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              },
              "additionalProperties": false
            }
          ]
        },
        "valuation": {
          "description": "What one step of the pool's resource is worth, or (SS-2b) the marker \"pending\": the worth is not known yet. A pending valuation changes nothing but the net benefit of a judged task that touches the pool, which it makes unknown.",
          "oneOf": [
            { "$ref": "#/$defs/valuation" },
            { "const": "pending" }
          ]
        },
        "stop_line": {
          "description": "SS-2h: the pool's stop line, written with hard_line: a fact reference of the pool's scope plus an offset (meant as its capacity fact less a margin) or a constant. The capped spending order spends a pool that reached its cap down to it. Without the two lines the stop line is the capacity. A schedule.json that writes it names pool_lines in requires.",
          "$ref": "#/$defs/poolLine"
        },
        "hard_line": {
          "description": "SS-2h: the pool's hard line, below its stop line, written with stop_line: no dispatch the scheduler chooses leaves the pool below it. Without the two lines it is 0.",
          "$ref": "#/$defs/poolLine"
        },
        "trigger_line": {
          "description": "#428 SCHED-C1c: the pool's trigger line, written only beside stop_line and hard_line, at or above the stop line and at most the capacity: a capped episode begins at a reading at or above it. Without it the capacity. A schedule.json that writes it names pool_trigger_line in requires.",
          "$ref": "#/$defs/poolLine"
        },
        "target_defaults": {
          "description": "#455 B3-P (since 0.12.82): the gap step and the importance a resource target on the pool takes when it carries none of its own, read at each evaluation from the catalog in force; written only on a pool that writes no valuation (beside a valuation block or the pending marker it is type_mismatch at the member). It makes nothing else of the pool valued. A schedule.json whose pool writes it names pool_target_defaults in requires.",
          "$ref": "#/$defs/targetDefaults"
        }
      },
      "dependentRequired": {
        "stop_line": ["hard_line"],
        "hard_line": ["stop_line"],
        "trigger_line": ["stop_line", "hard_line"]
      },
      "dependentSchemas": {
        "target_defaults": { "not": { "required": ["valuation"] } }
      },
      "additionalProperties": false
    },
    "targetDefaults": {
      "description": "#455 B3-P: both members required, within the goal document's bounds of a target's own scale and importance_milli.",
      "type": "object",
      "required": ["scale", "importance_milli"],
      "properties": {
        "scale": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "importance_milli": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "additionalProperties": false
    },
    "poolLine": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "$ref": "./common.schema.json#/$defs/factReference" }
      ]
    },
    "valuation": {
      "type": "object",
      "required": ["name", "unit", "scale", "base_weight_milli"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$" },
        "scale": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "base_weight_milli": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "gap": {
          "type": "object",
          "required": ["rule", "weight_milli"],
          "properties": {
            "rule": { "const": "shortfall_linear" },
            "weight_milli": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
