{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actingcommand.local/contracts/scheduling/v2/tasks.schema.json",
  "title": "ActingCommand Scheduling Tasks v2",
  "type": "object",
  "required": ["schema_version", "catalog", "tasks"],
  "properties": {
    "schema_version": { "const": "actingcommand.scheduling.v2" },
    "catalog": { "$ref": "./common.schema.json#/$defs/catalog" },
    "tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operationRef": {
      "type": "object",
      "required": ["operation_id"],
      "properties": {
        "operation_id": { "$ref": "./common.schema.json#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "reserve": {
      "type": "object",
      "required": ["pool_id", "at_least"],
      "properties": {
        "pool_id": { "$ref": "./common.schema.json#/$defs/itemId" },
        "at_least": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "loadProfile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "light" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "heavy" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "cpu_milli", "gpu_milli", "io_milli"],
          "properties": {
            "kind": { "const": "weighted" },
            "cpu_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "gpu_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "io_milli": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "additionalProperties": false
        }
      ]
    },
    "failurePolicy": {
      "type": "object",
      "required": ["action", "retry_limit", "retry_backoff_ms", "escalation_threshold"],
      "properties": {
        "action": { "enum": ["continue", "pause"] },
        "retry_limit": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "retry_backoff_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "escalation_threshold": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "loopBudget": {
      "type": "object",
      "properties": {
        "daily_limit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "window_iteration_limit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_runtime_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "instanceOverride": {
      "type": "object",
      "required": ["instance_id", "enabled", "priority", "strategic_weight_milli", "load_profile"],
      "properties": {
        "instance_id": { "$ref": "./common.schema.json#/$defs/instanceAlias" },
        "enabled": { "type": ["boolean", "null"] },
        "priority": { "type": ["integer", "null"], "minimum": -32768, "maximum": 32767 },
        "strategic_weight_milli": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "load_profile": {
          "oneOf": [
            { "$ref": "#/$defs/loadProfile" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "entrypoint",
        "procedure_ref",
        "priority",
        "trigger",
        "feedback_stop",
        "consumes",
        "produces",
        "on_failure",
        "sensitive",
        "next_run_clamp_ms",
        "yield_points",
        "expected_duration_ms",
        "cooldown_ms",
        "load_profile",
        "strategic_weight_milli",
        "instance_overrides"
      ],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/itemId" },
        "scope": { "$ref": "./common.schema.json#/$defs/scope" },
        "entrypoint": { "$ref": "#/$defs/operationRef" },
        "procedure_ref": { "$ref": "./common.schema.json#/$defs/identifier" },
        "priority": { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "trigger": { "$ref": "./common.schema.json#/$defs/predicate" },
        "feedback_stop": { "$ref": "./common.schema.json#/$defs/predicate" },
        "consumes": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "./common.schema.json#/$defs/resourceEffect" }
        },
        "produces": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "./common.schema.json#/$defs/resourceEffect" }
        },
        "on_failure": { "$ref": "#/$defs/failurePolicy" },
        "sensitive": { "type": "boolean" },
        "next_run_clamp_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "yield_points": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "./common.schema.json#/$defs/identifier" }
        },
        "expected_duration_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "load_profile": { "$ref": "#/$defs/loadProfile" },
        "loop_budget": { "$ref": "#/$defs/loopBudget" },
        "strategic_weight_milli": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "instance_overrides": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/instanceOverride" }
        },
        "continues_from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "./common.schema.json#/$defs/identifier" }
        },
        "dispatch_parameters": { "type": "boolean" },
        "benefit_judged": {
          "description": "SS-2b: true marks a business task judged by its net benefit within its tier; the standard-pack composer writes it on every rule whose package is not maintenance-role. false is as without the member.",
          "type": "boolean"
        },
        "benefit_realization": {
          "description": "SS-2d: true marks a judged task the model verified as a realization or conversion with a real downstream use; within its rounding error it may run last in its tier. The compiler requires benefit_judged true, a consumes and a produces entry, a reserve on and a fact reading of each consumed pool, and no cycle among the marked tasks (realization_cycle). The standard-pack composer writes it from the schedule.json rule member realization. false is as without the member.",
          "type": "boolean"
        },
        "benefit_limited": {
          "description": "SS-2h: true marks a judged task whose runs a limit counts (its own, or an income cap that counts it); the capped spending order lists it in an episode's first round only. The compiler requires benefit_judged true. The standard-pack composer writes it from the schedule.json rule member limited. false is as without the member.",
          "type": "boolean"
        },
        "benefit_fixed_value_milli": {
          "description": "SCHED-C1a: V, the value of one run of a judged task without the cost of the pools it consumes, in milli of the value unit its instance's valuations weigh in; its net benefit is V less the cost of what it consumes, its produces unread. The compiler requires benefit_judged true (missing_required_field at benefit_judged), refuses a value outside 1..=9007199254740991 (limit_exceeded) and refuses it beside a produces entry on a pool whose valuation is declared or pending, or beside benefit_realization true (fixed_value_conflict). The standard-pack composer writes it from the schedule.json rule member fixed_value_milli. It is not value_milli.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_queue_wait_ms": {
          "description": "Workflow #437 ORD-1a: the longest time, in milliseconds, a candidate of the task may wait in its device's queue while another application of the device is in front. Only the order within a device group of several reads it; a task without it takes that order's default. A schedule.json rule writes it as any V2 member and names queue_wait in requires. The compiler refuses a value outside 60000..=86400000 (limit_exceeded).",
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000
        },
        "irreversible_reach": {
          "description": "Workflow #455 G-R2s: true marks a task whose package, or a chain follower that rides with it, can do something irreversible by its game root's declarations, or whose game root has a package that could not be read; a resource target never weighs its candidate, which is computed as on an instance without a target record. The standard-pack composer writes it and refuses a schedule.json rule that writes it. false is as without the member.",
          "type": "boolean"
        },
        "reserves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/reserve" }
        }
      },
      "additionalProperties": false
    }
  }
}
